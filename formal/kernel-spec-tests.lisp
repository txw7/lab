    (is-equal 0 (getf summary :mismatched))))

(defun test-compare-frozen-kernel-spec-kr-kl ()
  (let* ((spec (mini-kernel:make-frozen-kernel-core-spec))
         (report (mini-kernel:compare-kernel-spec-kr-kl spec))
         (entries (getf report :entries)))
    (is-true (getf report :matchedp))
    (is-equal 6 (length entries))
    (is-true (every (lambda (entry) (getf entry :matchedp)) entries))
    (is-equal
     '((:wf-empty-context :accepted :accepted)
       (:typing-zero-nat :accepted :accepted)
       (:typing-zero-sort-rejected :rejected :rejected)
       (:defeq-zero-zero :accepted :accepted)
       (:defeq-zero-succ-zero-rejected :rejected :rejected)
       (:let-step-zero :accepted :accepted))
     (mapcar (lambda (entry)
               (list (getf entry :id)
                     (getf entry :kr-status)
                     (getf entry :kl-status)))
             entries))))

(defun test-certificate-kernel-spec-kr-kl ()
  (let* ((spec (mini-kernel:make-certificate-kernel-spec :accepted-limit 4 :rejected-limit 4))
         (kr-results (mini-kernel:check-kernel-spec-kr spec))
         (kl-results (mini-kernel:check-kernel-spec-kl spec))
         (kr-summary (mini-kernel:summarize-kernel-spec-results kr-results))
         (kl-summary (mini-kernel:summarize-kernel-spec-results kl-results))
         (report (mini-kernel:compare-kernel-spec-kr-kl spec)))
    (is-equal 8 (getf kr-summary :total))
    (is-equal 8 (getf kl-summary :total))
    (is-equal 4 (getf kr-summary :accepted))
    (is-equal 4 (getf kl-summary :accepted))
    (is-equal 4 (getf kr-summary :rejected))
    (is-equal 4 (getf kl-summary :rejected))
    (is-equal 8 (getf kr-summary :matched))
    (is-equal 8 (getf kl-summary :matched))
    (is-true (getf report :matchedp))
    (is-equal
     '((:proof-demo :accepted :accepted)
       (:zero-has-nat :accepted :accepted)
       (:ctx-var0-has-nat :accepted :accepted)
       (:let-zero-has-nat :accepted :accepted)
       (:zero-is-not-proof :rejected :rejected)
       (:wrong-equality-claim :rejected :rejected)
       (:ctx-var0-wrong-type :rejected :rejected)
       (:let-zero-not-proof :rejected :rejected))
     (mapcar (lambda (entry)
               (list (getf entry :id)
                     (getf entry :kr-status)
                     (getf entry :kl-status)))
             (getf report :entries)))))

(defun test-defeq-kernel-spec-kr-kl ()
  (let* ((spec (mini-kernel:make-defeq-kernel-spec))
         (kr-results (mini-kernel:check-kernel-spec-kr spec))
         (kl-results (mini-kernel:check-kernel-spec-kl spec))
         (kr-summary (mini-kernel:summarize-kernel-spec-results kr-results))
         (kl-summary (mini-kernel:summarize-kernel-spec-results kl-results))
         (report (mini-kernel:compare-kernel-spec-kr-kl spec)))
    (is-equal 5 (getf kr-summary :total))
    (is-equal 5 (getf kl-summary :total))
    (is-equal 4 (getf kr-summary :accepted))
    (is-equal 4 (getf kl-summary :accepted))
    (is-equal 1 (getf kr-summary :rejected))
    (is-equal 1 (getf kl-summary :rejected))
    (is-true (getf report :matchedp))
    (is-equal
     '((:defeq-add-zero-succ :accepted :accepted)
       (:defeq-zero-succ-zero :rejected :rejected)
       (:defeq-var0-var0 :accepted :accepted)
       (:defeq-beta-zero :accepted :accepted)
       (:defeq-let-zero :accepted :accepted))
     (mapcar (lambda (entry)
               (list (getf entry :id)
                     (getf entry :kr-status)
                     (getf entry :kl-status)))
             (getf report :entries)))))

(defun test-default-kernel-spec-suite ()
  (let ((suite (mini-kernel:make-default-kernel-spec-suite)))
    (is-equal 4 (length suite))
    (is-true
     (every (lambda (spec)
              (getf (mini-kernel:compare-kernel-spec-kr-kl spec) :matchedp))
            suite))))

