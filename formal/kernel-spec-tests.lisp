(defun run-tests ()
  (let* ((tests
           (list
            (cons "check-frozen-kernel-spec-kr"
                  #'test-check-frozen-kernel-spec-kr)
            (cons "check-frozen-kernel-spec-kl"
                  #'test-check-frozen-kernel-spec-kl)
            (cons "check-frozen-kernel-spec-defir"
                  #'test-check-frozen-kernel-spec-defir)
            (cons "compare-frozen-kernel-spec-kr-kl"
                  #'test-compare-frozen-kernel-spec-kr-kl)
            (cons "compare-frozen-kernel-spec-kr-kl-defir"
                  #'test-compare-frozen-kernel-spec-kr-kl-defir)
            (cons "certificate-kernel-spec-kr-kl"
                  #'test-certificate-kernel-spec-kr-kl)
            (cons "defeq-kernel-spec-kr-kl"
                  #'test-defeq-kernel-spec-kr-kl)
            (cons "step-kernel-spec-kr-kl-defir"
                  #'test-step-kernel-spec-kr-kl-defir)
            (cons "default-kernel-spec-suite"
                  #'test-default-kernel-spec-suite)
            (cons "default-kernel-spec-suite-kr-kl-defir"
                  #'test-default-kernel-spec-suite-kr-kl-defir)))
         (passed 0)
         (failed 0))
    (dolist (test tests)
      (if (run-test (car test) (cdr test))
          (incf passed)
          (incf failed)))
    (format t "~%passed: ~D failed: ~D~%" passed failed)
    (when (plusp failed)
      (fail-test "kernel spec test suite failed"))
    t))
